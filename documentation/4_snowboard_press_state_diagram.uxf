  <element>
    <id>UMLState</id>
    <coordinates>
      <x>1066</x>
      <y>1443</y>
      <w>845</w>
      <h>130</h>
    </coordinates>
    <panel_attributes>SetProfileMenu
--
entry/ for button in run_profile_buttons:          lv_obj_clear_flag(button, HIDDEN)
       for indicator in run_profile_indicators:    lv_obj_clear_flag(indicator, HIDDEN)

exit/  for button in run_profile_buttons:          lv_obj_add_flag(button, HIDDEN)
       for indicator in run_profile_indicators:    lv_obj_add_flag(indicator, HIDDEN)
valign=top
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates>
      <x>1066</x>
      <y>702</y>
      <w>845</w>
      <h>663</h>
    </coordinates>
    <panel_attributes>ManualMenu
--
entry/   for button in manual_buttons:          lv_obj_clear_flag(button, HIDDEN)
         for indicator in manual_indicators:    lv_obj_clear_flag(indicator, HIDDEN)
         
         localPresSetpoint = threadsafe_get_pressure_setpoint()
         localTopTempSetpoint = threadsafe_get_temp_setpoint(top)
         localBtmTempSetpoint = threadsafe_get_temp_setpoint(btm)

exit/    for button in manual_buttons:          lv_obj_add_flag(button, HIDDEN)
         for indicator in manual_indicators:    lv_obj_add_flag(indicator, HIDDEN)


WAIT_IND_TIMER /     lv_label_set_text(pressure_indicator, threadsafe_get_pressure())
                     lv_label_set_text(top_temp_indicator, threadsafe_get_temp(top))
                     lv_label_set_text(btm_temp_indicator, threadsafe_get_temp(btm))
                   
P_SETPOINT_UP /      threadsafe_set_pressure_setpoint(++localPresSetpoint)
                     lv_label_set_text(pressure_setpoint_indicator, threadsafe_get_pressure_setpoint())
                     Send(NEW_P_SETPOINT, PressureHandler)
                   
P_SETPOINT_DOWN /    threadsafe_set_pressure_setpoint(--localPresSetpoint)
                     lv_label_set_text(pressure_setpoint_indicator, threadsafe_get_pressure_setpoint())
                     Send(NEW_P_SETPOINT, PressureHandler)

T_T_SETPOINT_UP /    threadsafe_set_temp_setpoint(top, ++localTopTempSetpoint)
                     lv_label_set_text(top_temp_setpoint_indicator, threadsafe_get_temp_setpoint(top))
                     Send(NEW_T_T_SETPOINT, TemperatureHandler)

T_T_SETPOINT_DOWN /  threadsafe_set_temp_setpoint(btm, --localTopTempSetpoint)
                     lv_label_set_text(top_temp_setpoint_indicator, threadsafe_get_temp_setpoint(top))
                     Send(NEW_T_T_SETPOINT, TemperatureHandler)

T_B_SETPOINT_UP /    threadsafe_set_temp_setpoint(btm, ++localBtmTempSetpoint)
                     lv_label_set_text(top_temp_setpoint_indicator, threadsafe_get_temp_setpoint(btm))
                     Send(NEW_T_B_SETPOINT, TemperatureHandler)

T_B_SETPOINT_DOWN /  threadsafe_set_temp_setpoint(btm, --localBtmTempSetpoint)
                     lv_label_set_text(top_temp_setpoint_indicator, threadsafe_get_temp_setpoint(btm))
                     Send(NEW_T_B_SETPOINT, TemperatureHandler)
                    
valign=top
</panel_attributes>
