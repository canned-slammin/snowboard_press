      <h>765</h>
    </coordinates>
    <panel_attributes>ManualMenu
--
entry/   for button in manual_buttons:          lv_obj_clear_flag(button, HIDDEN)
         for indicator in manual_indicators:    lv_obj_clear_flag(indicator, HIDDEN)

exit/    for button in manual_buttons:          lv_obj_add_flag(button, HIDDEN)
         for indicator in manual_indicators:    lv_obj_add_flag(indicator, HIDDEN)


WAIT_IND_TIMER /     update pressure reading indicator
                     update temperature reading indicators
                   
P_SETPOINT_UP /      Lock(pSetpoint)
                     pSetpoint++
                     Unlock(pSetpoint)
                     update pressure setpoint indicator
                     Send(NEW_P_SETPOINT, PressureHandler, obj-&gt;pSetpoint)
                   
P_SETPOINT_DOWN /    Lock(pSetpoint)
                     pSetpoint--
                     Unlock(pSetpoint)
                     update pressure setpoint indicator
                     Send(NEW_P_SETPOINT, PressureHandler, obj-&gt;pSetpoint)

T_T_SETPOINT_UP /    Lock(tBlanketSetpoint)
                     tBlanketSetpoint++
                     Unlock(tBlanketSetpoint)
                     update top temperature setpoint indicator
                     set_temp_setpoint(topBlanketSetpoint, topBlanketObject, tBlanketSetpoint++)

T_T_SETPOINT_DOWN /  Lock(tBlanketSetpoint)
                     tBlanketSetpoint--
                     Unlock(tBlanketSetpoint)
                     update top temperature setpoint indicator
                     Send(NEW_T_SETPOINT, TemperatureHandler, obj-&gt;t_t_setpoint)

T_B_SETPOINT_UP /    Lock(bBlanketSetpoint)
                     bBlanketSetpoint++
                     Unlock(bBlanketSetpoint)
                     update bottom temperature setpoint indicator
                     Send(NEW_T_SETPOINT, TemperatureHandler, obj-&gt;t_b_setpoint)

T_B_SETPOINT_DOWN /  Lock(bBlanketSetpoint)
                     bBlanketSetpoint--
                     Unlock(bBlanketSetpoint)
                     update bottom temperature setpoint indicator
                     Send(NEW_T_SETPOINT, TemperatureHandler, obj-&gt;t_b_setpoint)
                    
valign=top
</panel_attributes>
