    </coordinates>
    <panel_attributes>PressureHandler
--

entry/  localPresSetpoint = threadsafe_get_pressure_setpoint()

exit/


NEW_P_SETPOINT /   localPressure = threadsafe_get_pressure_setpoint() 
                            
                            
valign=top
</panel_attributes>
