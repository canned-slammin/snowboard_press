    </coordinates>
    <panel_attributes>RunProfileMenu
--
entry/ for button in set_profile_buttons:          lv_obj_clear_flag(button, HIDDEN)
       for indicator in set_profile_indicators:    lv_obj_clear_flag(indicator, HIDDEN)

exit/  for button in set_profile_buttons:          lv_obj_add_flag(button, HIDDEN)
       for indicator in set_profile_indicators:    lv_obj_add_flag(indicator, HIDDEN)

# alt version with profile handler:
# polls for state of profile handler and updates label (feasible?)
# start button triggers handler going from Idle to Build Pressure
# poll pressure level until pressure is reached
# PRESSURE_REACHED sent to handler to trigger Hold Pressure (but how to only trigger this once?)
# PRESSURE_REACHED starts hold timer
# HOLD_TIMER sent to profile handler
# HOLD_TIMER starts temperature polling
# HEAT_REACHED sent to profile handler
# HEAT_REACHED ends temperature polling
# HEAT_REACHED starts dwell timer
          
valign=top
</panel_attributes>
