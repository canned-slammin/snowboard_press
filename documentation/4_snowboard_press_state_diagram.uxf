    <panel_attributes>Menus
--

entry/          start timer(graphicsPeriod)
                for button in menus_buttons: lv_obj_clear_flag(button, HIDDEN)
                
                pSetpointMutex = unlocked
                tBlanketSetpointMutex = unlocked
                bBlanketSetpointMutex = unlocked
                
                pSetpoint = defaultPressureSetpoint
                tBlanketSetpoint = defaultTemperatureSetpoint
                bBlanketSetpoint = defaultTemperatureSetpoint

WAIT_GX_TIMER / stop timer
                lv_task_handler()
                start timer(graphicsPeriod)


                

                
valign=top
</panel_attributes>
