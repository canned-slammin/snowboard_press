      <h>312</h>
    </coordinates>
    <panel_attributes>RunProfileMenu
--
entry/ for button in set_profile_buttons:          lv_obj_clear_flag(button, HIDDEN)
       for indicator in set_profile_indicators:    lv_obj_clear_flag(indicator, HIDDEN)

exit/  for button in set_profile_buttons:          lv_obj_add_flag(button, HIDDEN)
       for indicator in set_profile_indicators:    lv_obj_add_flag(indicator, HIDDEN)

RPM_POLL_TIMER       /   lv_label_set_text(pressure_indicator, threadsafe_get_pressure())
                         lv_label_set_text(top_temp_indicator, threadsafe_get_temp(top))
                         lv_label_set_text(btm_temp_indicator, threadsafe_get_temp(btm))
                         if item in profile_status_q: update profile status label

START_BUTTON_PRESSED /   Send event START_PROFILE to ProfileHandler
                         Disable Start button
                         Enable Abort button

ABORT_BUTTON_PRESSED /   Send ABORT signal to ProfileHandler

PROCESS_COMPLETE     /   Disable ABORT button
          
valign=top
</panel_attributes>
    <additional_attributes/>
  </element>
