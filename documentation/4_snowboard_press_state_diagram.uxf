<diagram program="umlet" version="15.1">
  <help_text>// Uncomment the following line to change the fontsize and font:
fontsize=10
fontfamily=Monospaced //possible: SansSerif,Serif,Monospaced


//////////////////////////////////////////////////////////////////////////////////////////////
// Welcome to UMLet!
//
// Double-click on elements to add them to the diagram, or to copy them
// Edit elements by modifying the text in this panel
// Hold Ctrl to select multiple elements
// Use Ctrl+mouse to select via lasso
//
// Use +/- or Ctrl+mouse wheel to zoom
// Drag a whole relation at its central square icon
//
// Press Ctrl+C to copy the whole diagram to the system clipboard (then just paste it to, eg, Word)
// Edit the files in the "palettes" directory to create your own element palettes
//
// Select "Custom Elements &gt; New..." to create new element types
//////////////////////////////////////////////////////////////////////////////////////////////


// This text will be stored with each diagram;  use it for notes.</help_text>
  <zoom_level>12</zoom_level>
  <element>
    <id>UMLState</id>
    <coordinates>
      <x>504</x>
      <y>60</y>
      <w>1032</w>
      <h>4260</h>
    </coordinates>
    <panel_attributes>Started
--
























































































































































































































































-.



valign=top
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates>
      <x>528</x>
      <y>180</y>
      <w>984</w>
      <h>2748</h>
    </coordinates>
    <panel_attributes>Menus
--

entry/          init display

                start timer(graphicsPeriod)
                for button in menus_buttons: lv_obj_clear_flag(button, HIDDEN)
                
                presSetpointMutex = unlocked
                topTempSetpointMutex = unlocked
                btmTempSetpointMutex = unlocked
                
                presSetpoint = defaultPressureSetpoint
                topTempSetpoint = defaultTemperatureSetpoint
                btmTempSetpoint = defaultTemperatureSetpoint

WAIT_GX_TIMER / stop timer
                lv_task_handler()
                start timer(graphicsPeriod)


                

                
valign=top
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLState</id>
    <coordinates>
      <x>648</x>
      <y>3684</y>
      <w>804</w>
      <h>300</h>
    </coordinates>
    <panel_attributes>PressureHandler
--

entry/  set_valve_states(0x00)

        localPresSetpoint = threadsafe_get_pressure_setpoint()
        localPressure = get_pressure_reading()
        threadsafe_set_pressure(localPressure)
        
        start_timer(presCtrlPeriod)

exit/


NEW_P_SETPOINT /   localPresSetpoint = threadsafe_get_pressure_setpoint() 

P_CTRL_TIMER /     localPressure = get_pressure_reading()
                   threadsafe_set_pressure(localPressure)
                   
                   inlValveState = localPressure &gt; localPresSetpoint.upperBound
                   exhValveState = localPressure &lt; localPresSetpoint.lowerBound 
                   set_valve_states(inlValveState &amp; (exhValveState &lt;&lt; 1))
                             

                            
valign=top
</panel_attributes>
    <additional_attributes/>
  </element>
